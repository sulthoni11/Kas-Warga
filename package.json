{
  "name": "scff",
  "version": "0.2.0",
  "private": true,
  "description": "Smart Community Festive Fund (SCFF) — pengelolaan dana sosial komunitas dengan ledger append-only",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace @scff/api",
    "dev:web": "npm run dev --workspace @scff/web",
    "build": "npm run build --workspace @scff/web",
    "start": "npm start --workspace @scff/api"
  },
  "engines": {
    "node": ">=20"
  }
}
