# Salin menjadi .env lalu sesuaikan. JANGAN commit file .env.

# --- Aplikasi ---
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:5173

# --- MySQL (cocok dengan docker-compose.yml) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=scff
DB_USER=scff_app
DB_PASSWORD=scff_dev_password
DB_ROOT_PASSWORD=scff_root_password
DB_POOL_MAX=10

# --- Integrasi (ARSITEKTUR AWAL: dummy saja, lihat PRD §13.5 & D1) ---
WA_PROVIDER=console
PAYMENT_PROVIDER=dummy
DUMMY_WEBHOOK_SECRET=dev-only-secret-change-me

# --- Job terjadwal ---
ENABLE_CRON=false
